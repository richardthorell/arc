cmake_minimum_required(VERSION 3.20)
include("${INPUT}")

function(json_quote value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(file_record source output)
    if(NOT IS_ABSOLUTE "${source}" OR NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        message(FATAL_ERROR "Runtime output is missing: ${source}")
    endif()
    file(REAL_PATH "${source}" source)
    file(SHA256 "${source}" digest)
    file(SIZE "${source}" size)
    json_quote("${source}" quoted)
    set(${output} "{\"path\":${quoted},\"size\":${size},\"sha256\":\"${digest}\"}" PARENT_SCOPE)
endfunction()

set(document "{\"format\":\"arc.runtime-build\",\"formatVersion\":1}")
foreach(field projectGuid engineVersion profile targetId role cmakeTarget configuration)
    json_quote("${${field}}" quoted)
    string(JSON document SET "${document}" "${field}" "${quoted}")
endforeach()
file_record("${executable}" record)
string(JSON document SET "${document}" executable "${record}")
foreach(group LIBRARIES PLUGINS)
    string(TOLOWER "${group}" key)
    set(records "[]")
    set(index 0)
    foreach(source IN LISTS ${group})
        file_record("${source}" record)
        string(JSON records SET "${records}" ${index} "${record}")
        math(EXPR index "${index} + 1")
    endforeach()
    string(JSON document SET "${document}" "${key}" "${records}")
endforeach()
# Keep the previous successful record intact if any required file is missing.
file(WRITE "${OUTPUT}.tmp" "${document}\n")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
