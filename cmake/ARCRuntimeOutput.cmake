include_guard(GLOBAL)

# Register one runtime executable, not an editor module. The named target builds
# it and refreshes exact output metadata even when the linker is already up-to-date.
function(arc_register_runtime_output)
    cmake_parse_arguments(ARG "" "TARGET;PROJECT_GUID;ENGINE_VERSION;PROFILE;RENDERER;ROLE" "LIBRARIES;PLUGINS" ${ARGN})
    foreach(required TARGET PROJECT_GUID ENGINE_VERSION PROFILE RENDERER ROLE)
        if(NOT ARG_${required})
            message(FATAL_ERROR "arc_register_runtime_output requires ${required}")
        endif()
    endforeach()
    if(ARG_UNPARSED_ARGUMENTS OR TARGET arc-runtime-output)
        message(FATAL_ERROR "Unknown runtime output arguments or duplicate runtime registration")
    endif()
    get_target_property(kind ${ARG_TARGET} TYPE)
    if(NOT kind STREQUAL "EXECUTABLE" OR NOT ARG_ROLE MATCHES "^(client|server)$")
        message(FATAL_ERROR "Runtime output requires an executable and client/server role")
    endif()
    string(TOLOWER "${CMAKE_SYSTEM_NAME}" platform)
    if(platform STREQUAL "darwin")
        set(platform macos)
    endif()
    set(machine "${CMAKE_SYSTEM_PROCESSOR}")
    if(MSVC AND CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
        set(machine "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
    endif()
    string(TOLOWER "${machine}" machine)
    if(machine MATCHES "^(amd64|x86_64|x64)$" AND CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(architecture x64)
    elseif(machine MATCHES "^(aarch64|arm64)$" AND CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(architecture arm64)
    else()
        message(FATAL_ERROR "Unsupported runtime output architecture: ${machine}")
    endif()
    set(renderer "${ARG_RENDERER}")
    if(renderer STREQUAL "none")
        set(renderer headless)
    endif()
    set(target_id "${platform}-${architecture}-${renderer}")
    set(spec "")
    foreach(pair IN ITEMS "projectGuid;${ARG_PROJECT_GUID}" "engineVersion;${ARG_ENGINE_VERSION}"
            "profile;${ARG_PROFILE}" "targetId;${target_id}" "role;${ARG_ROLE}"
            "cmakeTarget;${ARG_TARGET}" "configuration;$<CONFIG>" "executable;$<TARGET_FILE:${ARG_TARGET}>")
        list(GET pair 0 key)
        list(GET pair 1 value)
        if(value MATCHES "\\]==\\]")
            message(FATAL_ERROR "Unsafe runtime metadata delimiter")
        endif()
        string(APPEND spec "set(${key} [==[${value}]==])\n")
    endforeach()
    foreach(group LIBRARIES PLUGINS)
        string(APPEND spec "set(${group})\n")
        foreach(dependency IN LISTS ARG_${group})
            get_target_property(dependency_kind ${dependency} TYPE)
            if(NOT dependency_kind MATCHES "^(SHARED_LIBRARY|MODULE_LIBRARY)$")
                message(FATAL_ERROR "Runtime dependency must be a shared/module target: ${dependency}")
            endif()
            string(APPEND spec "list(APPEND ${group} [==[$<TARGET_FILE:${dependency}>]==])\n")
        endforeach()
    endforeach()
    # Use the active compiler's redistributable inventory, never a directory scan
    # in the editor. Keep these exact files in the hashed build output contract.
    if(MSVC)
        set(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP TRUE)
        include(InstallRequiredSystemLibraries)
        foreach(runtime IN LISTS CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS)
            string(APPEND spec "list(APPEND LIBRARIES [==[${runtime}]==])\n")
        endforeach()
    endif()
    set(spec_path "${CMAKE_CURRENT_BINARY_DIR}/arc-runtime-input-$<CONFIG>.cmake")
    file(GENERATE OUTPUT "${spec_path}" CONTENT "${spec}")
    add_custom_target(arc-runtime-output
        COMMAND "${CMAKE_COMMAND}" "-DINPUT=${spec_path}"
            "-DOUTPUT=${CMAKE_BINARY_DIR}/arc-runtime-$<CONFIG>.json"
            -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ARCWriteRuntimeOutput.cmake"
        DEPENDS ${ARG_TARGET} ${ARG_LIBRARIES} ${ARG_PLUGINS}
        VERBATIM)
endfunction()

function(_arc_collect_directory_targets directory output)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(subdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(subdirectory IN LISTS subdirectories)
        _arc_collect_directory_targets("${subdirectory}" nested_targets)
        list(APPEND targets ${nested_targets})
    endforeach()
    set(${output} "${targets}" PARENT_SCOPE)
endfunction()

# Compatibility for projects created before ARC exposed arc-runtime-output.
# Registration is deferred until the complete project target graph exists and
# refuses to guess when a project contains more than one runtime executable.
function(_arc_register_workflow_runtime_output)
    if(TARGET arc-runtime-output)
        return()
    endif()
    _arc_collect_directory_targets("${CMAKE_SOURCE_DIR}" project_targets)
    set(runtime_targets)
    foreach(target IN LISTS project_targets)
        get_target_property(imported "${target}" IMPORTED)
        get_target_property(kind "${target}" TYPE)
        if(kind STREQUAL "EXECUTABLE" AND NOT imported)
            list(APPEND runtime_targets "${target}")
        endif()
    endforeach()
    list(LENGTH runtime_targets runtime_target_count)
    if(NOT runtime_target_count EQUAL 1)
        message(FATAL_ERROR
            "ARC workflow requires exactly one runtime executable when arc-runtime-output is not registered; "
            "found ${runtime_target_count}. Call arc_register_runtime_output(...) explicitly in the project CMakeLists.txt.")
    endif()
    list(GET runtime_targets 0 runtime_target)
    get_target_property(linked_targets "${runtime_target}" LINK_LIBRARIES)
    set(runtime_libraries)
    foreach(linked IN LISTS linked_targets)
        if(TARGET "${linked}")
            get_target_property(linked_kind "${linked}" TYPE)
            if(linked_kind MATCHES "^(SHARED_LIBRARY|MODULE_LIBRARY)$")
                list(APPEND runtime_libraries "${linked}")
            endif()
        endif()
    endforeach()
    arc_register_runtime_output(
        TARGET "${runtime_target}"
        PROJECT_GUID "${ARC_WORKFLOW_PROJECT_GUID}"
        ENGINE_VERSION "${ARC_WORKFLOW_ENGINE_VERSION}"
        PROFILE "${ARC_WORKFLOW_PROFILE}"
        RENDERER "${ARC_WORKFLOW_RENDERER}"
        ROLE "${ARC_WORKFLOW_ROLE}"
        LIBRARIES ${runtime_libraries})
endfunction()

function(arc_enable_workflow_runtime_output_compatibility)
    get_property(enabled GLOBAL PROPERTY ARC_WORKFLOW_RUNTIME_OUTPUT_COMPATIBILITY)
    if(enabled)
        return()
    endif()
    set_property(GLOBAL PROPERTY ARC_WORKFLOW_RUNTIME_OUTPUT_COMPATIBILITY TRUE)
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _arc_register_workflow_runtime_output)
endfunction()
