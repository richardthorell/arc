#version 450

#include "include/arc_virtual_shadows.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D previous_hzb;
layout(std430, set = 0, binding = 1) readonly buffer address_space_buffer
{
    ArcVirtualShadowAddressSpace address_spaces[];
};
layout(std430, set = 0, binding = 2) readonly buffer view_buffer
{
    ArcVirtualShadowView views[];
};
layout(std430, set = 0, binding = 3) buffer request_slot_buffer
{
    ArcVirtualShadowRequestSlot request_slots[];
};
layout(std430, set = 0, binding = 4) buffer feedback_header_buffer
{
    uint request_count;
    uint raw_request_count;
    uint duplicate_count;
    uint overflow_count;
    uint receiver_sample_count;
    uint reserved0;
    uint reserved1;
    uint reserved2;
} feedback;

layout(push_constant) uniform virtual_shadow_marking_constants
{
    mat4 inverse_view_projection;
    uvec4 viewport_address_spaces; // width, height, address-space count, request capacity
    uvec4 frame_revision; // frame low/high, revision low/high
    uvec4 sampling; // sample stride, expansion radius, history valid, reserved
} constants;

const uint ARC_SHADOW_KIND_DIRECTIONAL = 0u;
const uint ARC_SHADOW_MOBILITY_STATIC = 0u;
const uint ARC_SHADOW_MOBILITY_MOVABLE = 2u;
const uint ARC_SHADOW_LAYER_STATIC = 0u;
const uint ARC_SHADOW_LAYER_DYNAMIC = 1u;
const uint ARC_SHADOW_REQUEST_FILTER_EXPANDED = 2u;
const uint ARC_SHADOW_REQUEST_MOTION_EXPANDED = 4u;

uint request_hash(uvec4 identity_page)
{
    uint value = 2166136261u;
    value = (value ^ identity_page.x) * 16777619u;
    value = (value ^ identity_page.y) * 16777619u;
    value = (value ^ identity_page.z) * 16777619u;
    value = (value ^ identity_page.w) * 16777619u;
    return max(value, 2u);
}

bool same_request(ArcVirtualShadowPageRequest lhs, ArcVirtualShadowPageRequest rhs)
{
    return all(equal(lhs.identityPage, rhs.identityPage));
}

void insert_request(ArcVirtualShadowPageRequest request)
{
    atomicAdd(feedback.raw_request_count, 1u);
    uint capacity = constants.viewport_address_spaces.w;
    if (capacity == 0u)
    {
        atomicAdd(feedback.overflow_count, 1u);
        return;
    }
    uint hash = request_hash(request.identityPage);
    uint slot = hash % capacity;
    for (uint probe = 0u; probe < min(capacity, 32u); ++probe)
    {
        uint previous = atomicCompSwap(request_slots[slot].hash, 0u, hash);
        if (previous == 0u)
        {
            request_slots[slot].request = request;
            memoryBarrierBuffer();
            atomicExchange(request_slots[slot].ready, 1u);
            return;
        }
        if (previous == hash)
        {
            for (uint spin = 0u; spin < 32u && atomicAdd(request_slots[slot].ready, 0u) == 0u; ++spin)
                memoryBarrierBuffer();
            if (request_slots[slot].ready != 0u && same_request(request_slots[slot].request, request))
            {
                atomicMax(request_slots[slot].request.demand.x, request.demand.x);
                atomicMax(request_slots[slot].request.demand.y, request.demand.y);
                atomicOr(request_slots[slot].request.demand.z, request.demand.z);
                atomicAdd(feedback.duplicate_count, 1u);
                return;
            }
        }
        slot = (slot + 1u) % capacity;
    }
    atomicAdd(feedback.overflow_count, 1u);
}

vec3 reconstruct_world_position(vec2 uv, float depth)
{
    vec2 clip_xy = vec2(uv.x * 2.0 - 1.0, (1.0 - uv.y) * 2.0 - 1.0);
    vec4 world = constants.inverse_view_projection * vec4(clip_xy, depth, 1.0);
    return world.xyz / max(abs(world.w), 1.0e-6);
}

void emit_page(uint address_index, ArcVirtualShadowAddressSpace address_space, ArcVirtualShadowView view,
               ivec2 page, uint layer, float coverage, uint flags)
{
    int pages_per_axis = int(view.pageRange.y);
    if (any(lessThan(page, ivec2(0))) || any(greaterThanEqual(page, ivec2(pages_per_axis))))
        return;
    ArcVirtualShadowPageRequest request;
    request.identityPage = uvec4(address_index, address_space.identityTopology.x,
                                 uint(page.x) | (uint(page.y) << 16u),
                                 view.pageRange.w | (view.pageRange.z << 8u) | (layer << 16u));
    request.frameRevision = constants.frame_revision;
    request.demand = uvec4(floatBitsToUint(coverage), address_space.requestMetadata.y, flags, 0u);
    insert_request(request);
}

void main()
{
    if (constants.sampling.z == 0u)
        return;
    uvec2 viewport = constants.viewport_address_spaces.xy;
    uint stride = max(constants.sampling.x, 1u);
    uvec2 pixel = gl_GlobalInvocationID.xy * stride + uvec2(stride / 2u);
    if (any(greaterThanEqual(pixel, viewport)))
        return;
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(viewport);
    float depth = textureLod(previous_hzb, uv, 0.0).r;
    if (isnan(depth) || isinf(depth) || depth >= 1.0)
        return;
    atomicAdd(feedback.receiver_sample_count, 1u);
    vec3 world_position = reconstruct_world_position(uv, depth);
    float coverage = float(stride * stride) / max(float(viewport.x * viewport.y), 1.0);
    uint address_count = constants.viewport_address_spaces.z;
    for (uint address_index = 0u; address_index < address_count; ++address_index)
    {
        ArcVirtualShadowAddressSpace address_space = address_spaces[address_index];
        if (address_space.identityTopology.x == 0u ||
            address_space.identityTopology.y != ARC_SHADOW_KIND_DIRECTIONAL)
            continue;
        uint level_count = arcVirtualShadowLevelCount(address_space);
        for (uint level = 0u; level < level_count; ++level)
        {
            ArcVirtualShadowView view = views[arcVirtualShadowViewIndex(address_space, 0u, level)];
            vec4 clip = arcVirtualShadowTransform(view, world_position);
            if (abs(clip.w) <= 1.0e-6)
                continue;
            vec2 shadow_uv = clip.xy / clip.w * 0.5 + 0.5;
            if (any(lessThan(shadow_uv, vec2(0.0))) || any(greaterThanEqual(shadow_uv, vec2(1.0))))
                continue;
            ivec2 center = ivec2(floor(shadow_uv * float(view.pageRange.y)));
            int radius = int(constants.sampling.y);
            for (int y = -radius; y <= radius; ++y)
            {
                for (int x = -radius; x <= radius; ++x)
                {
                    uint flags = (x != 0 || y != 0) ? ARC_SHADOW_REQUEST_FILTER_EXPANDED : 0u;
                    if (radius != 0)
                        flags |= ARC_SHADOW_REQUEST_MOTION_EXPANDED;
                    if (address_space.requestMetadata.x != ARC_SHADOW_MOBILITY_MOVABLE)
                        emit_page(address_index, address_space, view, center + ivec2(x, y),
                                  ARC_SHADOW_LAYER_STATIC, coverage, flags);
                    if (address_space.requestMetadata.x != ARC_SHADOW_MOBILITY_STATIC)
                        emit_page(address_index, address_space, view, center + ivec2(x, y),
                                  ARC_SHADOW_LAYER_DYNAMIC, coverage, flags);
                }
            }
            break;
        }
    }
}
