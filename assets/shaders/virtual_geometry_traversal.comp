#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct gpu_scene_instance
{
    vec4 bounds_min;
    vec4 bounds_max;
    uvec4 geometry;
    uvec4 material_flags;
    uvec4 draw_metadata;
    vec2 distance_error;
    uvec2 material_attribute;
};

struct gpu_scene_transform
{
    mat4 model;
    mat4 previous_model;
};

struct virtual_resource
{
    uvec4 nodes_clusters;
    uvec4 children_pages;
    uvec4 roots_generation;
};

struct virtual_node
{
    vec4 sphere;
    vec4 normal_cone;
    float geometric_error;
    uint first_cluster;
    uint cluster_count;
    uint first_child;
    uint child_count;
    uint page_index;
    uint level;
    uint flags;
};

struct virtual_page
{
    uint heap_index;
    uint heap_byte_offset;
    uint stored_size;
    uint decoded_size;
    uint resource_generation;
    uint flags;
    uint last_used_frame;
    uint reserved;
};

struct visible_cluster
{
    uint instance_index;
    uint resource_index;
    uint cluster_index;
    uint page_index;
    uint material_index;
    uint hierarchy_level;
    uint flags;
    float view_depth;
};

struct page_request
{
    uint resource_index;
    uint handle_generation;
    uint resource_generation;
    uint page_index;
    float projected_error;
    float screen_coverage;
    float distance;
    uint flags;
};

struct fallback_record
{
    uint instance_index;
    uint resource_index;
    uint hierarchy_node;
    uint reason;
};

layout(std430, set = 0, binding = 0) readonly buffer gpu_scene_buffer { gpu_scene_instance instances[]; } scene;
layout(std430, set = 0, binding = 1) readonly buffer transform_buffer { gpu_scene_transform transforms[]; } transform_table;
layout(std430, set = 0, binding = 2) readonly buffer resource_buffer { virtual_resource resources[]; } resource_table;
layout(std430, set = 0, binding = 3) readonly buffer node_buffer { virtual_node nodes[]; } node_table;
layout(std430, set = 0, binding = 4) readonly buffer child_buffer { uint children[]; } child_table;
layout(std430, set = 0, binding = 5) readonly buffer root_buffer { uint roots[]; } root_table;
layout(std430, set = 0, binding = 6) readonly buffer page_buffer { virtual_page pages[]; } page_table;
layout(std430, set = 0, binding = 7) writeonly buffer visible_buffer { visible_cluster visible[]; } output_clusters;
layout(std430, set = 0, binding = 8) writeonly buffer request_buffer { page_request requests[]; } output_requests;
layout(std430, set = 0, binding = 9) buffer counter_buffer
{
    uint visible_count;
    uint request_count;
    uint frustum_rejected;
    uint cone_rejected;
    uint hzb_rejected;
    uint projected_size_rejected;
    uint visible_overflow;
    uint request_overflow;
    uint fallback_instances;
    uint parent_fallbacks;
    uint traversal_overflow;
    uint fallback_overflow;
    uint bin_count;
    uint previous_hzb_tested;
    uint previous_hzb_rejected;
    uint current_hzb_tested;
    uint current_hzb_rejected;
    uint refinement_candidates;
    uint hysteresis_refine_suppressed;
    uint hysteresis_coarsen_suppressed;
    uint refinement_history_overflow;
    uint pressure_suppressed_requests;
    uint refinement_frontier_count;
    uint refinement_frontier_overflow;
    uint traversed_nodes;
    uint raster_clusters;
    uint raster_triangles;
    uint raster_indirect_commands;
} counters;
layout(std430, set = 0, binding = 10) writeonly buffer fallback_buffer
{
    fallback_record instances[];
} output_fallbacks;
layout(set = 0, binding = 11) uniform sampler2D hzb_generations[2];
layout(std430, set = 0, binding = 12) buffer refinement_history_a_buffer
{
    uint keys[];
} refinement_history_a;
layout(std430, set = 0, binding = 13) buffer refinement_history_b_buffer
{
    uint keys[];
} refinement_history_b;
layout(std430, set = 0, binding = 14) buffer refinement_frontier_buffer
{
    uint instance_indices[];
} refinement_frontier;

layout(push_constant) uniform traversal_constants
{
    mat4 view_projection;
    vec4 camera_position_and_error;
    uvec4 capacities;
    vec4 viewport_hzb;
    uint hzb_generation;
    uint history_invalidation_mask;
    uint fallback_capacity;
    uint traversal_stack_capacity;
} constants;

const uint fallback_traversal_overflow = 1u;
const uint fallback_visible_overflow = 2u;
const uint fallback_unavailable_parent = 4u;
const uint instance_recently_changed = 1u << 5u;
const uint request_visible_child = 1u;
const uint request_speculative = 1u << 2u;
const uint request_current_frame = 1u << 3u;
const uint traversal_phase_previous_hzb = 1u;
const uint traversal_phase_current_hzb = 2u;
const uint history_probe_count = 8u;

uint traversal_phase()
{
    return (constants.hzb_generation >> 2u) & 3u;
}

uint history_capacity()
{
    return 1u << ((constants.hzb_generation >> 8u) & 31u);
}

uint refinement_key(uint instance_index, gpu_scene_instance instance, uint resource_generation, uint node_index)
{
    uint value = instance_index * 0x9e3779b9u;
    value ^= instance.draw_metadata.z * 0x85ebca6bu;
    value ^= resource_generation * 0xc2b2ae35u;
    value ^= node_index * 0x27d4eb2fu;
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    return value | 1u;
}

uint load_history_key(uint generation, uint slot)
{
    return generation == 0u ? refinement_history_a.keys[slot] : refinement_history_b.keys[slot];
}

bool refinement_history_overflowed(uint generation)
{
    return load_history_key(generation, 0u) != 0u;
}

bool was_refined_last_frame(uint key, uint generation)
{
    uint capacity = history_capacity();
    uint slots = max(capacity - 1u, 1u);
    uint start = 1u + key % slots;
    for (uint probe = 0u; probe < history_probe_count; ++probe)
    {
        uint slot = 1u + (start - 1u + probe) % slots;
        uint stored = load_history_key(generation, slot);
        if (stored == key)
            return true;
        if (stored == 0u)
            return false;
    }
    return false;
}

void record_refinement(uint key, uint generation)
{
    uint capacity = history_capacity();
    uint slots = max(capacity - 1u, 1u);
    uint start = 1u + key % slots;
    for (uint probe = 0u; probe < history_probe_count; ++probe)
    {
        uint slot = 1u + (start - 1u + probe) % slots;
        uint stored = generation == 0u ? atomicCompSwap(refinement_history_a.keys[slot], 0u, key)
                                       : atomicCompSwap(refinement_history_b.keys[slot], 0u, key);
        if (stored == 0u || stored == key)
            return;
    }
    if (generation == 0u)
        atomicOr(refinement_history_a.keys[0], 1u);
    else
        atomicOr(refinement_history_b.keys[0], 1u);
    atomicAdd(counters.refinement_history_overflow, 1u);
}

bool sphere_in_frustum(vec3 center, float radius)
{
    vec4 clip = constants.view_projection * vec4(center, 1.0);
    float extent = max(abs(clip.w), 1.0e-4);
    return clip.x >= -extent - radius && clip.x <= extent + radius && clip.y >= -extent - radius &&
           clip.y <= extent + radius && clip.z >= -radius && clip.z <= extent + radius;
}

bool page_resident(uint page_index, uint generation)
{
    virtual_page page = page_table.pages[page_index];
    return (page.flags & 1u) != 0u && page.resource_generation == generation;
}

void request_page(uint resource_index, uint handle_generation, uint generation, uint page_index,
                  float projected_error, float distance_to_node, uint flags)
{
    bool speculative = (flags & request_speculative) != 0u;
    uint limit = speculative ? max(constants.capacities.w * 3u / 4u, 1u) : constants.capacities.w;
    uint request_index = atomicAdd(counters.request_count, 0u);
    while (request_index < limit)
    {
        uint observed = atomicCompSwap(counters.request_count, request_index, request_index + 1u);
        if (observed == request_index)
            break;
        request_index = observed;
    }
    if (request_index >= limit)
    {
        if (speculative)
            atomicAdd(counters.pressure_suppressed_requests, 1u);
        else
            atomicAdd(counters.request_overflow, 1u);
        return;
    }
    output_requests.requests[request_index].resource_index = resource_index;
    output_requests.requests[request_index].handle_generation = handle_generation;
    output_requests.requests[request_index].resource_generation = generation;
    output_requests.requests[request_index].page_index = page_index;
    output_requests.requests[request_index].projected_error = projected_error;
    output_requests.requests[request_index].screen_coverage =
        clamp(projected_error / max(constants.viewport_hzb.y, 1.0), 0.0, 1.0);
    output_requests.requests[request_index].distance = distance_to_node;
    output_requests.requests[request_index].flags = flags;
}

void queue_fallback(uint instance_index, uint resource_index, uint hierarchy_node, uint reason,
                    inout bool fallback_queued)
{
    if (fallback_queued)
        return;
    fallback_queued = true;
    uint fallback_index = atomicAdd(counters.fallback_instances, 1u);
    if (fallback_index >= constants.fallback_capacity)
    {
        atomicAdd(counters.fallback_overflow, 1u);
        return;
    }
    output_fallbacks.instances[fallback_index].instance_index = instance_index;
    output_fallbacks.instances[fallback_index].resource_index = resource_index;
    output_fallbacks.instances[fallback_index].hierarchy_node = hierarchy_node;
    output_fallbacks.instances[fallback_index].reason = reason;
}

void main()
{
    uint phase = traversal_phase();
    uint work_index = gl_GlobalInvocationID.x;
    uint instance_index = work_index;
    if (phase == traversal_phase_current_hzb)
    {
        if (work_index >= min(counters.refinement_frontier_count, constants.capacities.x))
            return;
        instance_index = refinement_frontier.instance_indices[work_index];
    }
    if (instance_index >= constants.capacities.x)
        return;
    gpu_scene_instance instance = scene.instances[instance_index];
    if (instance.geometry.w != 3u || (instance.material_flags.w & 1u) == 0u ||
        instance.geometry.x >= constants.capacities.y)
        return;

    virtual_resource resource_record = resource_table.resources[instance.geometry.x];
    uint resource_generation = resource_record.roots_generation.z;
    if (resource_record.roots_generation.w != instance.geometry.y || resource_generation == 0u)
        return;

    uint stack[64];
    uint stack_count = 0u;
    uint stack_capacity = clamp(constants.traversal_stack_capacity, 1u, 64u);
    bool fallback_queued = false;
    bool refinement_survivor = false;
    for (uint root = 0u; root < resource_record.roots_generation.y; ++root)
    {
        if (stack_count == stack_capacity)
        {
            atomicAdd(counters.traversal_overflow, 1u);
            queue_fallback(instance_index, instance.geometry.x,
                           root_table.roots[resource_record.roots_generation.x + root],
                           fallback_traversal_overflow, fallback_queued);
            return;
        }
        stack[stack_count++] = root_table.roots[resource_record.roots_generation.x + root];
    }

    mat4 model = transform_table.transforms[instance_index].model;
    float scale = max(length(model[0].xyz), max(length(model[1].xyz), length(model[2].xyz)));
    while (stack_count != 0u)
    {
        uint node_index = stack[--stack_count];
        atomicAdd(counters.traversed_nodes, 1u);
        virtual_node node = node_table.nodes[node_index];
        vec3 center = (model * vec4(node.sphere.xyz, 1.0)).xyz;
        float radius = node.sphere.w * scale;
        if (!sphere_in_frustum(center, radius))
        {
            atomicAdd(counters.frustum_rejected, 1u);
            continue;
        }
        vec3 to_camera = constants.camera_position_and_error.xyz - center;
        float distance_to_node = max(length(to_camera), 1.0e-4);
        if ((instance.material_flags.w & (1u << 8u)) == 0u && node.normal_cone.w >= 0.0)
        {
            vec3 cone_axis = normalize(mat3(model) * node.normal_cone.xyz);
            float cone_sine = sqrt(max(0.0, 1.0 - node.normal_cone.w * node.normal_cone.w));
            if (dot(cone_axis, to_camera / distance_to_node) <= -cone_sine)
            {
                atomicAdd(counters.cone_rejected, 1u);
                continue;
            }
        }
        float nearest_distance = max(distance_to_node - radius, 1.0e-4);
        float projected_radius = radius * constants.viewport_hzb.y / nearest_distance;
        if (projected_radius < 0.5)
        {
            atomicAdd(counters.projected_size_rejected, 1u);
            continue;
        }
        bool recently_changed = (instance.material_flags.w & instance_recently_changed) != 0u;
        bool previous_history_valid = constants.history_invalidation_mask == 0u && !recently_changed;
        bool can_test_hzb = constants.viewport_hzb.w > 0.5 &&
                            (phase == traversal_phase_current_hzb || previous_history_valid);
        if (can_test_hzb)
        {
            if (phase == traversal_phase_current_hzb)
                atomicAdd(counters.current_hzb_tested, 1u);
            else
                atomicAdd(counters.previous_hzb_tested, 1u);
            vec4 clip = constants.view_projection * vec4(center, 1.0);
            vec2 uv = clip.xy / max(clip.w, 1.0e-5) * 0.5 + 0.5;
            float depth = clip.z / max(clip.w, 1.0e-5);
            float mip = clamp(floor(log2(max(projected_radius, 1.0))), 0.0,
                              max(constants.viewport_hzb.z - 1.0, 0.0));
            float farthest = textureLod(hzb_generations[constants.hzb_generation & 1u], uv, mip).g;
            if (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0))) &&
                depth - radius / max(abs(clip.w), 1.0e-4) > farthest + 1.0e-4)
            {
                atomicAdd(counters.hzb_rejected, 1u);
                if (phase == traversal_phase_current_hzb)
                    atomicAdd(counters.current_hzb_rejected, 1u);
                else
                    atomicAdd(counters.previous_hzb_rejected, 1u);
                continue;
            }
        }

        float projected_error = node.geometric_error * instance.distance_error.y * constants.viewport_hzb.y /
                                nearest_distance;
        if (node.child_count != 0u)
            atomicAdd(counters.refinement_candidates, 1u);
        float threshold = constants.camera_position_and_error.w;
        bool nominal_refinement = node.child_count != 0u && projected_error > threshold;
        uint current_history = (constants.hzb_generation >> 1u) & 1u;
        uint previous_history = current_history ^ 1u;
        bool refinement_history_valid = previous_history_valid && !refinement_history_overflowed(previous_history);
        bool refined_last_frame = refinement_history_valid &&
                                  was_refined_last_frame(refinement_key(instance_index, instance, resource_generation,
                                                                       node_index),
                                                         previous_history);
        float stable_threshold = threshold;
        if (refinement_history_valid)
            stable_threshold = refined_last_frame ? threshold * 0.9 : threshold * 1.1;
        bool descend = node.child_count != 0u && projected_error > stable_threshold;
        if (nominal_refinement && !descend)
            atomicAdd(counters.hysteresis_refine_suppressed, 1u);
        else if (!nominal_refinement && descend)
            atomicAdd(counters.hysteresis_coarsen_suppressed, 1u);
        if (descend)
        {
            for (uint child_offset = 0u; child_offset < node.child_count; ++child_offset)
            {
                uint child_index = child_table.children[node.first_child + child_offset];
                virtual_node child = node_table.nodes[child_index];
                if (!page_resident(child.page_index, resource_generation))
                {
                    descend = false;
                    uint request_flags = request_visible_child;
                    if (phase == traversal_phase_previous_hzb)
                        request_flags |= request_speculative;
                    else if (phase == traversal_phase_current_hzb)
                        request_flags |= request_current_frame;
                    request_page(instance.geometry.x, instance.geometry.y, resource_generation, child.page_index,
                                 projected_error, distance_to_node, request_flags);
                }
            }
        }
        if (descend)
        {
            if (stack_count + node.child_count > stack_capacity)
            {
                atomicAdd(counters.traversal_overflow, 1u);
                queue_fallback(instance_index, instance.geometry.x, node_index, fallback_traversal_overflow,
                               fallback_queued);
                descend = false;
            }
            if (descend)
            {
                if (phase != traversal_phase_previous_hzb)
                    record_refinement(refinement_key(instance_index, instance, resource_generation, node_index),
                                      current_history);
                for (uint child_offset = node.child_count; child_offset != 0u; --child_offset)
                    stack[stack_count++] = child_table.children[node.first_child + child_offset - 1u];
                continue;
            }
        }
        if (nominal_refinement)
            atomicAdd(counters.parent_fallbacks, 1u);
        if (!page_resident(node.page_index, resource_generation))
        {
            uint request_flags = request_visible_child;
            if (phase == traversal_phase_previous_hzb)
                request_flags |= request_speculative;
            else if (phase == traversal_phase_current_hzb)
                request_flags |= request_current_frame;
            request_page(instance.geometry.x, instance.geometry.y, resource_generation, node.page_index,
                         projected_error, distance_to_node, request_flags);
            queue_fallback(instance_index, instance.geometry.x, node_index, fallback_unavailable_parent,
                           fallback_queued);
            continue;
        }
        for (uint cluster = 0u; cluster < node.cluster_count; ++cluster)
        {
            uint visible_index = atomicAdd(counters.visible_count, 1u);
            if (visible_index >= constants.capacities.z)
            {
                atomicAdd(counters.visible_overflow, 1u);
                queue_fallback(instance_index, instance.geometry.x, node_index, fallback_visible_overflow,
                               fallback_queued);
                break;
            }
            output_clusters.visible[visible_index].instance_index = instance_index;
            output_clusters.visible[visible_index].resource_index = instance.geometry.x;
            output_clusters.visible[visible_index].cluster_index = node.first_cluster + cluster;
            output_clusters.visible[visible_index].page_index = node.page_index;
            output_clusters.visible[visible_index].material_index = instance.material_flags.x;
            output_clusters.visible[visible_index].hierarchy_level = node.level;
            output_clusters.visible[visible_index].flags = node.flags;
            output_clusters.visible[visible_index].view_depth = distance_to_node;
            refinement_survivor = true;
        }
    }
    if (phase == traversal_phase_previous_hzb && refinement_survivor)
    {
        uint frontier_index = atomicAdd(counters.refinement_frontier_count, 1u);
        if (frontier_index < constants.capacities.x)
            refinement_frontier.instance_indices[frontier_index] = instance_index;
        else
            atomicAdd(counters.refinement_frontier_overflow, 1u);
    }
}
