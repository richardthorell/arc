#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D current_color;
layout(set = 0, binding = 1) uniform sampler2D previous_color;
layout(set = 0, binding = 2) uniform sampler2D motion_vectors;
layout(set = 0, binding = 3) uniform sampler2D reactive_mask;
layout(set = 0, binding = 4) uniform sampler2D disocclusion_mask;
layout(set = 0, binding = 5) uniform sampler2D current_depth;
layout(set = 0, binding = 6) uniform sampler2D previous_moments;
layout(set = 0, binding = 7) uniform sampler2D previous_confidence;
layout(rgba16f, set = 0, binding = 8) uniform writeonly image2D resolved_color;
layout(r32f, set = 0, binding = 9) uniform writeonly image2D resolved_depth;
layout(rg16f, set = 0, binding = 10) uniform writeonly image2D resolved_moments;
layout(r8, set = 0, binding = 11) uniform writeonly image2D resolved_confidence;

layout(push_constant) uniform temporal_constants
{
    ivec2 output_extent;
    vec2 input_extent;
    uint history_valid;
    float base_history_weight;
} constants;

vec3 rgb_to_ycocg(vec3 value)
{
    return vec3(value.r * 0.25 + value.g * 0.5 + value.b * 0.25,
                value.r * 0.5 - value.b * 0.5,
                -value.r * 0.25 + value.g * 0.5 - value.b * 0.25);
}

vec3 ycocg_to_rgb(vec3 value)
{
    return vec3(value.x + value.y - value.z, value.x + value.z, value.x - value.y - value.z);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, constants.output_extent)))
        return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(constants.output_extent);
    vec3 current = textureLod(current_color, uv, 0.0).rgb;
    vec2 motion = textureLod(motion_vectors, uv, 0.0).xy;
    vec2 previous_uv = uv - motion;
    vec3 history = textureLod(previous_color, previous_uv, 0.0).rgb;

    vec3 minimum_color = vec3(1.0e20);
    vec3 maximum_color = vec3(-1.0e20);
    vec2 texel = 1.0 / max(constants.input_extent, vec2(1.0));
    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            vec3 sample_color = rgb_to_ycocg(textureLod(current_color, uv + vec2(x, y) * texel, 0.0).rgb);
            minimum_color = min(minimum_color, sample_color);
            maximum_color = max(maximum_color, sample_color);
        }
    }
    history = ycocg_to_rgb(clamp(rgb_to_ycocg(history), minimum_color, maximum_color));
    float reactive = textureLod(reactive_mask, uv, 0.0).r;
    float disoccluded = textureLod(disocclusion_mask, uv, 0.0).r;
    float history_weight = constants.history_valid != 0u
                               ? constants.base_history_weight * (1.0 - reactive) * (1.0 - disoccluded)
                               : 0.0;
    float previous_lock = textureLod(previous_confidence, previous_uv, 0.0).r;
    history_weight *= mix(0.5, 1.0, previous_lock);
    vec3 resolved = mix(current, history, clamp(history_weight, 0.0, 0.98));
    float luminance = dot(resolved, vec3(0.2126, 0.7152, 0.0722));
    vec2 old_moments = textureLod(previous_moments, previous_uv, 0.0).rg;
    vec2 moments = mix(vec2(luminance, luminance * luminance), old_moments, history_weight);
    float confidence = clamp(previous_lock + 1.0 / 16.0, 0.0, 1.0) * (1.0 - disoccluded);
    imageStore(resolved_color, pixel, vec4(max(resolved, vec3(0.0)), 1.0));
    imageStore(resolved_depth, pixel, vec4(textureLod(current_depth, uv, 0.0).r));
    imageStore(resolved_moments, pixel, vec4(moments, 0.0, 0.0));
    imageStore(resolved_confidence, pixel, vec4(confidence));
}
