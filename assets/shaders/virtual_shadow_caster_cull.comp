#version 450
#extension GL_GOOGLE_include_directive : require

#include "include/arc_virtual_shadows.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct gpu_scene_instance
{
    vec4 bounds_min;
    vec4 bounds_max;
    uvec4 geometry;
    uvec4 material_flags;
    uvec4 draw_metadata;
    vec2 distance_error;
    uvec2 material_attribute;
};

layout(std430, set = 0, binding = 0) readonly buffer gpu_scene_buffer
{
    gpu_scene_instance instances[];
} scene;
layout(std430, set = 0, binding = 1) readonly buffer render_page_buffer
{
    ArcVirtualShadowRenderPage pages[];
};
layout(std430, set = 0, binding = 2) buffer page_work_buffer
{
    ArcVirtualShadowPageWork page_work[];
};
layout(std430, set = 0, binding = 3) writeonly buffer caster_draw_buffer
{
    ArcVirtualShadowCasterDraw caster_draws[];
};

layout(push_constant) uniform caster_culling_constants
{
    uvec4 counts; // page count, instance count, casters/page, render layer mask
    vec4 camera_position;
} constants;

const uint ARC_GPU_SCENE_CASTS_SHADOWS = 1u << 3u;
const uint ARC_GPU_SCENE_BINDLESS_COMPATIBLE = 1u << 31u;
const uint ARC_GPU_SCENE_GEOMETRY_MESH = 0u;
const uint ARC_SHADOW_MOBILITY_STATIC = 0u;
const uint ARC_SHADOW_MOBILITY_MOVABLE = 2u;

bool intersects_page(ArcVirtualShadowRenderPage page, vec3 minimum_bounds, vec3 maximum_bounds)
{
    bool outside_left = true;
    bool outside_right = true;
    bool outside_bottom = true;
    bool outside_top = true;
    bool outside_near = true;
    bool outside_far = true;
    for (uint corner = 0u; corner < 8u; ++corner)
    {
        vec3 position = vec3((corner & 1u) != 0u ? maximum_bounds.x : minimum_bounds.x,
                             (corner & 2u) != 0u ? maximum_bounds.y : minimum_bounds.y,
                             (corner & 4u) != 0u ? maximum_bounds.z : minimum_bounds.z);
        vec4 clip = arcVirtualShadowPageTransform(page, position);
        outside_left = outside_left && clip.x < -clip.w;
        outside_right = outside_right && clip.x > clip.w;
        outside_bottom = outside_bottom && clip.y < -clip.w;
        outside_top = outside_top && clip.y > clip.w;
        outside_near = outside_near && clip.z < 0.0;
        outside_far = outside_far && clip.z > clip.w;
    }
    return !(outside_left || outside_right || outside_bottom || outside_top || outside_near || outside_far);
}

void main()
{
    uint page_index = gl_GlobalInvocationID.x;
    if (page_index >= constants.counts.x)
        return;

    ArcVirtualShadowRenderPage page = pages[page_index];
    ArcVirtualShadowPageWork work;
    work.casterCount = 0u;
    work.frustumRejected = 0u;
    work.mobilityRejected = 0u;
    work.distanceRejected = 0u;
    work.unsupportedCasters = 0u;
    work.overflowCount = 0u;
    work.reserved0 = 0u;
    work.reserved1 = 0u;
    uint layer = page.work.z;
    uint light_mobility = page.work.w;

    for (uint instance_index = 0u; instance_index < constants.counts.y; ++instance_index)
    {
        gpu_scene_instance instance = scene.instances[instance_index];
        uint flags = instance.material_flags.w;
        if ((flags & ARC_GPU_SCENE_CASTS_SHADOWS) == 0u ||
            (instance.material_flags.z & constants.counts.w) == 0u)
            continue;
        if (instance.geometry.w != ARC_GPU_SCENE_GEOMETRY_MESH)
            continue;

        uint mobility = (flags >> 16u) & 0x3u;
        bool accepted_mobility = layer == 0u ? mobility == ARC_SHADOW_MOBILITY_STATIC
                                             : (light_mobility == ARC_SHADOW_MOBILITY_MOVABLE ||
                                                mobility != ARC_SHADOW_MOBILITY_STATIC);
        if (!accepted_mobility)
        {
            ++work.mobilityRejected;
            continue;
        }
        if (instance.draw_metadata.x == 0u || (flags & ARC_GPU_SCENE_BINDLESS_COMPATIBLE) == 0u)
        {
            ++work.unsupportedCasters;
            continue;
        }
        vec3 center = (instance.bounds_min.xyz + instance.bounds_max.xyz) * 0.5;
        float maximum_shadow_distance = instance.bounds_min.w;
        if (maximum_shadow_distance > 0.0 &&
            distance(center, constants.camera_position.xyz) > maximum_shadow_distance)
        {
            ++work.distanceRejected;
            continue;
        }
        if (!intersects_page(page, instance.bounds_min.xyz, instance.bounds_max.xyz))
        {
            ++work.frustumRejected;
            continue;
        }
        if (work.casterCount >= page.work.y)
        {
            ++work.overflowCount;
            continue;
        }
        uint draw_index = page.work.x + work.casterCount++;
        ArcVirtualShadowCasterDraw draw;
        draw.indexCount = instance.draw_metadata.x;
        draw.instanceCount = 1u;
        draw.firstIndex = instance.draw_metadata.y;
        draw.vertexOffset = int(instance.draw_metadata.z);
        draw.firstInstance = instance_index;
        draw.pageIndex = page_index;
        draw.flags = flags;
        draw.reserved = 0u;
        caster_draws[draw_index] = draw;
    }
    page_work[page_index] = work;
}
