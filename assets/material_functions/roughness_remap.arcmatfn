{
  "kind": "materialFunction",
  "version": 1,
  "name": "Roughness Remap",
  "description": "Clamp roughness to [0,1], apply a configurable curve exponent, then remap to a minimum and maximum roughness.",
  "inputs": [
    {
      "id": "roughness",
      "name": "Roughness",
      "type": "float"
    },
    {
      "id": "min",
      "name": "Minimum Roughness",
      "type": "float",
      "default": 0
    },
    {
      "id": "max",
      "name": "Maximum Roughness",
      "type": "float",
      "default": 1
    },
    {
      "id": "power",
      "name": "Curve Exponent",
      "type": "float",
      "default": 1
    }
  ],
  "outputs": [
    {
      "id": "roughness",
      "name": "Roughness",
      "type": "float"
    }
  ],
  "graph": {
    "version": 1,
    "nodes": [
      {
        "id": "input-roughness",
        "type": "functionInput",
        "position": [
          30,
          80
        ],
        "values": {
          "input": "roughness",
          "name": "Roughness",
          "valueType": "float"
        }
      },
      {
        "id": "input-min",
        "type": "functionInput",
        "position": [
          30,
          260
        ],
        "values": {
          "input": "min",
          "name": "Minimum Roughness",
          "valueType": "float"
        }
      },
      {
        "id": "input-max",
        "type": "functionInput",
        "position": [
          30,
          430
        ],
        "values": {
          "input": "max",
          "name": "Maximum Roughness",
          "valueType": "float"
        }
      },
      {
        "id": "input-power",
        "type": "functionInput",
        "position": [
          30,
          600
        ],
        "values": {
          "input": "power",
          "name": "Curve Exponent",
          "valueType": "float"
        }
      },
      {
        "id": "clamp-input",
        "type": "saturate",
        "position": [
          280,
          80
        ],
        "values": {}
      },
      {
        "id": "epsilon",
        "type": "constant",
        "position": [
          280,
          750
        ],
        "values": {
          "value": 0.0001
        }
      },
      {
        "id": "safe-exponent",
        "type": "max",
        "position": [
          490,
          600
        ],
        "values": {}
      },
      {
        "id": "curve",
        "type": "power",
        "position": [
          650,
          130
        ],
        "values": {}
      },
      {
        "id": "remap",
        "type": "lerp",
        "position": [
          850,
          220
        ],
        "values": {}
      },
      {
        "id": "out",
        "type": "functionOutput",
        "position": [
          1040,
          220
        ],
        "values": {
          "pins": [
            {
              "id": "roughness",
              "name": "Roughness",
              "type": "float"
            }
          ]
        }
      }
    ],
    "connections": [
      {
        "id": "input",
        "from": {
          "nodeId": "input-roughness",
          "pin": "value"
        },
        "to": {
          "nodeId": "clamp-input",
          "pin": "value"
        }
      },
      {
