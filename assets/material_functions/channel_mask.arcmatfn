    {
      "id": "rgba",
      "name": "RGBA",
      "type": "vec4",
      "default": [
        1,
        1,
        1,
        1
      ]
    },
    {
      "id": "mask",
      "name": "Channel Weights (RGBA)",
      "type": "vec4",
      "default": [
        1,
        0,
        0,
        0
      ]
    }
  ],
  "outputs": [
    {
      "id": "value",
      "name": "Value",
      "type": "float"
    }
  ],
  "graph": {
