    {
      "id": "f0",
      "name": "F0",
      "type": "float",
      "default": 0.04
    },
    {
      "id": "cosTheta",
      "name": "Cosine of Incidence",
      "type": "float",
      "default": 1
    }
  ],
  "outputs": [
    {
      "id": "fresnel",
      "name": "Fresnel",
      "type": "float"
    }
  ],
