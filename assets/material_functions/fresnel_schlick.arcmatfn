{
  "kind": "materialFunction",
  "version": 1,
  "name": "Fresnel Schlick",
  "description": "Schlick Fresnel approximation F = F0 + (1-F0)(1-saturate(cosTheta))^5. Accepts scalar F0 and cosine of incidence angle.",
