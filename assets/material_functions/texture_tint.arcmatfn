        ],
        "values": {
          "path": "material_functions/tint_rgb.arcmatfn",
          "name": "Tint RGB",
          "inputPins": [
            {
              "id": "color",
              "name": "Sampled RGB",
              "type": "vec3"
            },
            {
              "id": "tint",
