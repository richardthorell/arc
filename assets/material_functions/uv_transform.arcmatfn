      "type": "vec2",
      "default": [
        0,
        0
      ]
    },
    {
      "id": "pivot",
      "name": "Pivot",
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "rotation",
      "name": "Rotation (radians)",
      "type": "float",
      "default": 0
    }
  ],
  "outputs": [
    {
      "id": "uv",
      "name": "UV",
      "type": "vec2"
    }
  ],
